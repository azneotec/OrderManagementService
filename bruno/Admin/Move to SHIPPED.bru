meta {
  name: Move to SHIPPED
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/orders/{{orderNumber}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "SHIPPED",
    "note": "Bluedart 123456"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq SHIPPED
}

tests {
  test("the new status is last on the timeline", function () {
    const last = res.body.events[res.body.events.length - 1];
    expect(last.status).to.equal("SHIPPED");
    expect(last.note).to.equal("Bluedart 123456");
  });
}

docs {
  Admin only (`adminToken`). Moves the COD order one step to SHIPPED; a customer then sees it on Get Tracking and gets an email.
}
