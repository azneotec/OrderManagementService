meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "name": "{{userName}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}",
    "phoneNumber": "{{userPhone}}"
  }
}

script:pre-request {
  // Email and phone are unique per user, so mint a fresh pair on every run.
  const stamp = Date.now();
  bru.setVar("userEmail", `bruno.oms.${stamp}@example.com`);
  bru.setVar("userPhone", `+65${String(stamp).slice(-8)}`);
}

assert {
  res.status: eq 201
}

docs {
  Registers a customer on user-auth-service (`authUrl`) with a generated email. Order requests need a bearer token
  from that service, so run the Setup folder first.
}
