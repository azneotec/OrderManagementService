meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{authUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
  }
}

assert {
  res.status: eq 200
  res.body.tokenType: eq Bearer
}

docs {
  Logs in as the customer created by Signup and stores the JWT as `token`.
}
