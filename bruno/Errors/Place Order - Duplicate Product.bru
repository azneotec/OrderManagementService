meta {
  name: Place Order - Duplicate Product
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "items": [
      {"productId": {{productId1}}, "quantity": 1},
      {"productId": {{productId1}}, "quantity": 2}
    ],
    "deliveryAddress": {
      "fullName": "Bruno User",
      "phoneNumber": "+15551234567",
      "addressLine1": "1 Main St",
      "addressLine2": "Flat 4",
      "city": "Pune",
      "state": "MH",
      "postalCode": "411001",
      "country": "IN"
    },
    "paymentMethod": "COD"
  }
}

assert {
  res.status: eq 400
}

docs {
  A product may appear on at most one line.
}
