meta {
  name: Place Order - No Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "items": [
      {"productId": {{productId1}}, "quantity": 2},
      {"productId": {{productId2}}, "quantity": 1}
    ],
    "deliveryAddress": {
      "fullName": "Bruno User",
      "phoneNumber": "+15551234567",
      "addressLine1": "1 Main St",
      "addressLine2": "Flat 4",
      "city": "Pune",
      "state": "MH",
      "postalCode": "411001",
      "country": "IN"
    },
    "paymentMethod": "COD"
  }
}

assert {
  res.status: eq 401
}
