meta {
  name: Place Order - Total Changed
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "items": [
      {"productId": {{productId1}}, "quantity": 2},
      {"productId": {{productId2}}, "quantity": 1}
    ],
    "deliveryAddress": {
      "fullName": "Bruno User",
      "phoneNumber": "+15551234567",
      "addressLine1": "1 Main St",
      "addressLine2": "Flat 4",
      "city": "Pune",
      "state": "MH",
      "postalCode": "411001",
      "country": "IN"
    },
    "paymentMethod": "COD",
    "expectedTotal": 0.01
  }
}

assert {
  res.status: eq 409
}

docs {
  `expectedTotal` is the amount the customer was quoted. When it differs from the catalog total the order is refused instead of charging another amount.
}
