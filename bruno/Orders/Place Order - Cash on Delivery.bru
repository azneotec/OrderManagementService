meta {
  name: Place Order - Cash on Delivery
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "items": [
      {"productId": {{productId1}}, "quantity": 2},
      {"productId": {{productId2}}, "quantity": 1}
    ],
    "deliveryAddress": {
      "fullName": "Bruno User",
      "phoneNumber": "+15551234567",
      "addressLine1": "1 Main St",
      "addressLine2": "Flat 4",
      "city": "Pune",
      "state": "MH",
      "postalCode": "411001",
      "country": "IN"
    },
    "paymentMethod": "COD"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("orderNumber", res.body.orderNumber);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq CONFIRMED
  res.body.paymentStatus: eq PAY_ON_DELIVERY
}

tests {
  test("is priced from the catalog", function () {
    expect(res.body.orderNumber).to.match(/^ORD-/);
    expect(res.body.items).to.have.length(2);
    expect(res.body.totalQuantity).to.equal(3);
    const sum = res.body.items.reduce((acc, i) => acc + i.lineTotal, 0);
    expect(res.body.totalAmount).to.be.closeTo(sum, 0.001);
  });
}

docs {
  Places a cash-on-delivery order for two catalog products. It is CONFIRMED straight away. Prices are never taken
  from the request: OMS reads them from the catalog. Stores `orderNumber`; the rest of the collection works on it.
  Needs user-auth-service and product-catalog-service reachable through Eureka, and products `productId1` and
  `productId2` in the catalog (environment variables).
}
