meta {
  name: Get Order
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/orders/{{orderNumber}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("is the order that was placed", function () {
    expect(res.body.orderNumber).to.equal(bru.getVar("orderNumber"));
    expect(res.body.deliveryAddress.city).to.equal("Pune");
  });
}

docs {
  One order in full. Only the owner can see it; anybody else gets 404.
}
