# Copy to .env (gitignored) and adjust. Read by `./mvnw spring-boot:run`, `make run` and `java -jar`.
# Unquoted values only. Anything also set as a real environment variable takes precedence.
# Defaults shown; remove a line to fall back to application.properties.

# MySQL from `make infra-up` (or the root stack's `make infra-up`, which uses the same port).
# Use jdbc:mysql://localhost:3306/order_management_service?createDatabaseIfNotExist=true for a host MySQL.
DB_URL=jdbc:mysql://localhost:3307/order_management_service?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=password

# Standalone runs have no Eureka server, so keep the client off. Remove it (or set true) to register with
# Eureka on http://localhost:8761 as order-management-service.
EUREKA_CLIENT_ENABLED=false

# Optional. The app listens on 8004 by default; set 9004 to run a second instance beside it.
#SERVER_PORT=9004
